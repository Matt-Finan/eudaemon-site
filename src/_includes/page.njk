---
layout: base.njk
---
<article>
  <p class="crumb">Standing page · updated in place</p>
  <h1 class="entry">{{ title }}</h1>
  <div class="metabox">
    <span><b>Started</b> {{ started }}</span>
    <span><b>Last updated</b> {{ updated }}</span>
    {% if note %}<span>{{ note }}</span>{% endif %}
  </div>

  {{ content | safe }}

  <p class="endmark"><span></span></p>
</article>
