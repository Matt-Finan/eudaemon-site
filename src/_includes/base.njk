<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }} · a one-person research programme{% endif %}</title>
<meta name="description" content="{{ summary or site.description }}">
<meta name="author" content="{{ site.author }}">
<link rel="icon" href="/assets/mark.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/touch-icon.png">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="stylesheet" href="/assets/site.css">
<link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="/feed.xml">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ summary or site.description }}">
<meta property="og:type" content="{% if layout == 'entry.njk' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.url }}/assets/og.png">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="wrap">

<header class="site">
  <a class="mast" href="/">
    <svg class="mark" width="42" height="42" viewBox="0 0 64 64" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round">
        <circle cx="32" cy="32" r="26" pathLength="100" stroke-dasharray="84.7 15.3" transform="rotate(4.5 32 32)"/>
        <circle cx="32" cy="32" r="18.3" pathLength="100" stroke-dasharray="84.7 15.3" transform="rotate(277.5 32 32)"/>
        <circle cx="32" cy="32" r="10.7" pathLength="100" stroke-dasharray="84.7 15.3" transform="rotate(189.5 32 32)"/>
      </g>
      <circle cx="32" cy="32" r="2.6" fill="#D9A441"/>
    </svg>
    <span class="wordmark">Eudaemon</span>
  </a>
  <nav class="site">
    <a href="/" {% if page.url == "/" %}class="here"{% endif %}>Log</a>
    <a href="/about/" {% if page.url == "/about/" %}class="here"{% endif %}>About</a>
    <a href="/feed.xml">RSS</a>
  </nav>
</header>
<hr class="rule">

<main id="main">
{{ content | safe }}
</main>

<footer class="site">
  <a href="/feed.xml">RSS</a><a href="mailto:{{ site.contact }}">{{ site.contact }}</a><a href="{{ site.repo }}" rel="me">Site source</a>
  <div class="foot-line">© 2026 {{ site.author }} · eudaemon.uk · a notebook that happens to be public</div>
</footer>

</div>
</body>
</html>
